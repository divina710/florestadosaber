rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidRankingEntry(data) {
      return data.keys().hasAll(['nome', 'pontuacao', 'criadoEm'])
        && data.keys().hasOnly(['nome', 'pontuacao', 'criadoEm'])
        && data.nome is string
        && data.nome.trim().size() >= 2
        && data.nome.size() >= 2
        && data.nome.size() <= 40
        && data.pontuacao is number
        && data.pontuacao > 0
        && data.pontuacao <= 100000000
        && data.criadoEm is timestamp
        && data.criadoEm == request.time;
    }

    // Coleção ranking: leitura pública, criação validada e imutável após envio
    match /ranking/{rankingId} {
      allow get: if isValidId(rankingId);
      allow list: if true;
      allow create: if isValidId(rankingId) && isValidRankingEntry(incoming());
      allow update, delete: if false;
    }
  }
}
